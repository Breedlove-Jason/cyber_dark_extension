{
  "manifest_version": 3,
  "name": "Cyber-Dark",
  "version": "1.0.0",
  "description": "Customizable dark mode extension like Midnight Lizard.",
  "icons": {
    "16": "icons/lightbulb-slash-lg.png",
    "48": "icons/lightbulb-slash-lg.png",
    "128": "icons/lightbulb-slash-lg.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/lightbulb-slash-lg.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
